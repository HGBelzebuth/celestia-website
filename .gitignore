application/logs/
application/cache/
application/sessions/

# ── Vendor PHP (recréer avec : composer install) ──────────────────
vendor/

# ── Cache viewer armory (regénéré automatiquement) ────────────────
application/modules/armory/assets/wmmv-cache/

# ── Uploads utilisateurs/admin (sauvegarder séparément) ──────────
assets/images/profiles/
assets/images/news/
assets/images/store/
assets/images/donate/

