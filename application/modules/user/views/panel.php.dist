        <div class="cwp__notif cwp__notif--<?= $transfer_type; ?>">
          <i class="fas fa-<?= $transfer_type === 'success' ? 'circle-check' : 'circle-xmark'; ?>"></i>
          <span><?= $transfer_msg; ?></span>
        </div>
