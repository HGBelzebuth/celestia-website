    <?php if (!empty($my_sponsor_token)): ?>
    <div class="cwp__card cwp__card--referral-hist" id="cwpMyReferral">
      <div class="cwp__card-hd">
        <div class="cwp__card-hd-l">
          <i class="fas fa-user-check" style="color:#c8a84b"></i>
          <h2 style="color:#d4a843">Mon parrainage</h2>
        </div>
