        Votre solde : <span class="cwp-dp-badge"><i class="fas fa-gem"></i><?= $dp_balance; ?> DP</span>
        <?php if ($dp_balance < $TRANSFER_COST): ?><br><span style="color:#e08080;font-size:1rem">⚠ Solde insuffisant.</span><?php endif; ?>
