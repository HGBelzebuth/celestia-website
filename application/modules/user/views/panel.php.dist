              <td class="cwp__info-lbl"><i class="fas fa-location-dot"></i><?= $this->lang->line('panel_last_ip'); ?></td>
              <td class="cwp__info-val"><?= $this->user_model->getLastIp($sess_id); ?></td>
            </tr>
