class Vote extends MX_Controller {

    public function __construct()
    {
        parent::__construct();
        $this->load->model('vote_model');

        if (!ini_get('date.timezone'))
           date_default_timezone_set($this->config->item('timezone') ?: 'Europe/Paris');

        if (!$this->wowgeneral->getMaintenance())
            redirect(base_url('maintenance'),'refresh');

        if (!$this->wowmodule->getVoteStatus())
            redirect(base_url(),'refresh');

        if (!$this->wowauth->isLogged()
            && $this->router->fetch_method() !== 'callbackTop100Arena'
            && $this->router->fetch_method() !== 'processrewards')
            redirect(base_url('login'),'refresh');
    }

    public function index()
    {
        $data = array(
            'pagetitle' => $this->lang->line('tab_vote'),
            'voteList' => $this->vote_model->getVotes(),
        );

        $this->template->build('index', $data);
    }

    public function voteNow($id)
    {
        $this->vote_model->voteNow($id);
    }

    public function voteNowCount()
    {
        $id = $this->input->post('value', TRUE);
        $seconds = $this->vote_model->getVoteTime($id);
        echo $this->vote_model->getCountDownHTML($id, $seconds);
    }

    public function voteCallURL()
    {
        $id = $this->input->post('value', TRUE);
        echo $this->vote_model->getVoteUrl($id);
    }

    public function verifyvote($id)
    {
        header('Content-Type: application/json');
        echo json_encode($this->vote_model->verifyVote($id));
    }

    public function leaderboard($period = 'weekly')
    {
        $period  = in_array($period, ['daily', 'weekly', 'monthly']) ? $period : 'weekly';
        $rewards = $this->db->where('period', $period)->order_by('rank_from', 'ASC')->get('vote_rewards')->result();

        // FIX : réassigner pour que les labels générés soient bien présents
        $rewards = $this->vote_model->buildRewardLabels($rewards);

        $data = [
            'pagetitle' => 'Top Votes',
            'period'    => $period,
            'rows'      => $this->vote_model->getLeaderboard($period, 20),
            'rewards'   => $rewards,
            'nextReset' => $this->vote_model->getNextReset($period),
        ];
        $this->template->build('leaderboard', $data);
    }

    public function leaderboard_data($period = 'weekly')
    {
        header('Content-Type: application/json');
        $period  = in_array($period, ['daily', 'weekly', 'monthly']) ? $period : 'weekly';
        $rewards = $this->db->where('period', $period)->order_by('rank_from', 'ASC')->get('vote_rewards')->result();

        // FIX : réassigner pour que les labels générés soient bien présents dans le JSON
        $rewards = $this->vote_model->buildRewardLabels($rewards);

        echo json_encode([
            'rows'       => $this->vote_model->getLeaderboard($period, 20),
            'rewards'    => $rewards,
            'next_reset' => $this->vote_model->getNextReset($period),
        ]);
    }

    public function processrewards($period = 'weekly', $secret = '')
    {
        if ($secret !== 'Cx7mK9vR2pQw') {
            http_response_code(403);
            echo 'Forbidden';
            return;
        }
        $period = in_array($period, ['daily', 'weekly', 'monthly']) ? $period : 'weekly';
        header('Content-Type: application/json');
        echo json_encode($this->vote_model->processRewards($period));
    }

    public function callbackTop100Arena()
    {
        $postback = $this->input->get('postback', TRUE);
        if (!$postback) {
            http_response_code(400);
            echo 'MISSING_USER';
            return;
        }

        $result = $this->vote_model->processTop100ArenaCallback($postback);
        http_response_code($result === 'ok' ? 200 : 400);
        echo $result;
    }

    /**
     * GET vote/characters/(:num)
     * Retourne la liste des personnages du joueur connecté sur le realm donné.
     * Utilisé pour peupler le <select> de sélection du perso de récompense.
     */
    public function characters($realmid = 1)
    {
        header('Content-Type: application/json');
        $userid  = (int) $this->session->userdata('wow_sess_id');
        $realmid = (int) $realmid;

        if (!$userid) {
            echo json_encode(['status' => 'error', 'message' => 'Session expirée.']);
            return;
        }

        $chars   = $this->vote_model->getCharacterList($userid, $realmid);
        $current = $this->vote_model->getRewardChar($userid);

        echo json_encode([
            'status'       => 'ok',
            'characters'   => $chars,
            'current_char' => $current ? $current->charname  : null,
            'current_realm'=> $current ? (int)$current->realm_id : $realmid,
        ]);
    }

    /**
     * POST vote/saverewardchar
     * Sauvegarde le personnage choisi pour recevoir les récompenses de classement.
     */
    public function saverewardchar()
    {
        header('Content-Type: application/json');
        $userid   = (int) $this->session->userdata('wow_sess_id');
        $realmid  = (int) $this->input->post('realm_id', TRUE);
        $charname = $this->input->post('charname', TRUE);

        if (!$userid) {
            echo json_encode(['status' => 'error', 'message' => 'Session expirée.']);
            return;
        }

        if (!$realmid || !$charname) {
            echo json_encode(['status' => 'error', 'message' => 'Données manquantes.']);
            return;
        }

        $result = $this->vote_model->saveRewardChar($userid, $realmid, $charname);

        if ($result === 'ok') {
            echo json_encode(['status' => 'ok', 'message' => 'Personnage enregistré avec succès.']);
        } elseif ($result === 'invalid_char') {
            echo json_encode(['status' => 'error', 'message' => 'Ce personnage n\'appartient pas à ton compte.']);
        } else {
            echo json_encode(['status' => 'error', 'message' => 'Erreur serveur, réessaie.']);
        }
    }

}
