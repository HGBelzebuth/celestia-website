            <?php if (empty($logs)): ?>
            <div class="cart-empty">
                <div class="cart-empty-icon"><i class="fas fa-history"></i></div>
                <h3>Aucun achat pour le moment</h3>
                <p>Vos achats apparaîtront ici après votre première commande.</p>
            </div>

            <?php else: ?>
            <div class="hist-list">
                <?php foreach ($logs as $log):
                    $isGift    = strpos($log->item_name, '[GIFT') === 0;
                    $cleanName = $isGift
                        ? preg_replace('/^\[GIFT[^\]]*\]\s*/', '', $log->item_name)
                        : $log->item_name;
                    $giftTarget = '';
                    if ($isGift && preg_match('/^\[GIFT\xe2\x86\x92([^\]]+)\]/', $log->item_name, $m)) {
                        $giftTarget = $m[1];
                    } elseif ($isGift && preg_match('/^\[GIFT.([^\]]+)\]/', $log->item_name, $m)) {
                        $giftTarget = $m[1];
                    }
                    $charLabel = isset($charNames[(int)$log->charid]) ? $charNames[(int)$log->charid] : '—';
                    $dp  = (int)$log->dp;
                    $vp  = (int)$log->vp;
                    $typeMap = [
                        1 => ['label' => 'Item',      'icon' => 'fa-archive',      'cls' => 'type-item'],
                        2 => ['label' => 'Monnaie',   'icon' => 'fa-coins',         'cls' => 'type-gold'],
                        3 => ['label' => 'Niveau',    'icon' => 'fa-arrow-up',      'cls' => 'type-level'],
                        4 => ['label' => 'Renommage', 'icon' => 'fa-pen',           'cls' => 'type-service'],
                        5 => ['label' => 'Apparence', 'icon' => 'fa-magic', 'cls' => 'type-service'],
                        6 => ['label' => 'Faction',   'icon' => 'fa-shield-alt', 'cls' => 'type-service'],
                        7 => ['label' => 'Race',      'icon' => 'fa-dna',           'cls' => 'type-service'],
                    ];
                    $t = $typeMap[(int)$log->type] ?? ['label' => 'Autre', 'icon' => 'fa-circle', 'cls' => 'type-item'];
                ?>
                <div class="hist-row <?= $isGift ? 'hist-row--gift' : '' ?>">

                    <div class="hist-type-dot <?= $t['cls'] ?>">
                        <?php
                        $svgPaths = [
                            'fa-archive'    => '<path d="M32 448c0 17.7 14.3 32 32 32h352c17.7 0 32-14.3 32-32V192H32v256zm160-212c0-6.6 5.4-12 12-12h72c6.6 0 12 5.4 12 12v4c0 6.6-5.4 12-12 12h-72c-6.6 0-12-5.4-12-12v-4zM480 32H32C14.3 32 0 46.3 0 64v64c0 8.8 7.2 16 16 16h480c8.8 0 16-7.2 16-16V64c0-17.7-14.3-32-32-32z"/>',
