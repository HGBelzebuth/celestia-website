                          <?php elseif($items->price_type == 4): ?>
                          <span class="blizzcms-item-price"><span uk-tooltip="title:<?=$this->lang->line('panel_dp'); ?>"><i class="dp-icon"></i></span><?= $items->dp ?> <span class="uk-badge">Ou</span><span uk-tooltip="title:<?=$this->lang->line('panel_vp'); ?>"><i class="vp-icon"></i></span><?= $items->vp ?></span>
