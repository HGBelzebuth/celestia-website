                        </div>
                      <?php else: ?>
                        <p class="offline-msg">
                          <i class="fas fa-exclamation-circle"></i>
                          <?= $this->lang->line('home_realm_info'); ?> —
                          <strong><?= $this->lang->line('offline'); ?></strong>
                        </p>
                      <?php endif ?>
                    <?php endforeach ?>
                  </div>
